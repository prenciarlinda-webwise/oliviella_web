# ---------------------------------------------------------------------------
# Olivella Miami — environment variables
# Copy this file to `.env.local` (git-ignored) and fill in real values.
# Never commit real secret keys to version control.
# ---------------------------------------------------------------------------

# --- Site URL (required in production) -------------------------------------
# Must match your actual domain so canonical tags and Stripe redirects work.
NEXT_PUBLIC_SITE_URL=https://www.olivellamiami.com

# --- Stripe (required for online booking deposits) -------------------------
# Get keys at https://dashboard.stripe.com/apikeys
# Use sk_test_... in development, sk_live_... in production.
# Until this is set, /book redirects to /contact automatically.
STRIPE_SECRET_KEY=sk_test_xxx

# Webhook signing secret — verifies that events come from Stripe, not a bad actor.
#
# Production:
#   1. Go to https://dashboard.stripe.com/webhooks → Add endpoint
#   2. URL: https://www.olivellamiami.com/api/stripe/webhook
#   3. Event: checkout.session.completed
#   4. Save → Reveal signing secret → paste below.
#
# Local dev (Stripe CLI):
#   $ brew install stripe/stripe-cli/stripe   # one-time install
#   $ stripe login
#   $ stripe listen --forward-to http://127.0.0.1:<PORT>/api/stripe/webhook
#   The CLI prints a whsec_... key — paste it below, then restart the server.
#   (Use 127.0.0.1 instead of localhost to avoid IPv6 port conflicts.)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Booking rules (optional — defaults shown) -----------------------------
# Flat deposit charged to hold a date, in cents. Default: $300.00
BOOKING_DEPOSIT_CENTS=30000
# ISO 4217 currency code. Default: usd
BOOKING_CURRENCY=usd
# Earliest bookable date = today + N days. Default: 7
BOOKING_MIN_LEAD_DAYS=7
# Latest bookable date = today + N days. Default: 540 (~18 months)
BOOKING_MAX_ADVANCE_DAYS=540

# --- Order notification email (optional — sent on successful Stripe payment) -
# Uses the Resend API (https://resend.com). All three vars must be set or
# notification emails are skipped — Stripe Dashboard remains the source of truth.
#
# Setup:
#   1. Create a free account at https://resend.com
#   2. Add & verify your domain (olivellamiami.com) under Domains
#   3. Create an API key under API Keys → paste as RESEND_API_KEY
RESEND_API_KEY=re_xxx
# Where booking confirmations are delivered (your business inbox).
ORDER_NOTIFICATION_EMAIL=olivellamiami@gmail.com
# Sender address — must be on a domain you have verified in Resend.
ORDER_FROM_EMAIL=bookings@olivellamiami.com
