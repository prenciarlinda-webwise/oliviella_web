# ---------------------------------------------------------------------------
# Olivella Miami — environment variables
# Copy this file to `.env.local` (git-ignored) and fill in real values.
# Never commit real secret keys to version control.
# ---------------------------------------------------------------------------

# --- Site URL (required in production) -------------------------------------
# Must match the canonical domain (no www; www should 301 to it at the host).
NEXT_PUBLIC_SITE_URL=https://olivellamiami.com

# --- Stripe (admin dashboard only) -------------------------------------------
# The website no longer takes card payments: /book is a free date check and
# /api/checkout returns 410. Stripe is only used by /admin to review card
# holds made before November 2026 and to send balance invoices.
# Use sk_test_... in development, sk_live_... in production.
STRIPE_SECRET_KEY=sk_test_xxx

# Webhook signing secret. Only needed while card holds made before November
# 2026 are still open (event: payment_intent.amount_capturable_updated,
# endpoint https://olivellamiami.com/api/stripe/webhook). Safe to remove the
# webhook in Stripe once those are settled.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Legacy flat deposit shown in old-hold notifications. Default: 30000 ($300)
BOOKING_DEPOSIT_CENTS=30000
BOOKING_CURRENCY=usd

# --- Form submissions ---------------------------------------------------------
# No env vars needed. The date-check form, the newsletter and the webhook all
# post to the Formspree endpoint in src/lib/site.ts (forwarded to
# olivellamiami@gmail.com). Check that Formspree plan's monthly limit.

# --- Admin area (required for /admin) ---------------------------------------
# Signs the admin login session cookie. Generate a long random value, e.g.:
#   $ openssl rand -base64 48
# Rotating this value immediately logs everyone out (all existing session
# cookies fail signature verification).
ADMIN_SESSION_SECRET=

# Admin accounts (system/shop roles) are NOT created via env vars — run
# `node scripts/create-admin.mjs` interactively (locally or over SSH on the
# server) to create the first accounts and to reset a password later. See
# that script's header comment for details.
